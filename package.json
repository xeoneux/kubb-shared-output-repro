{
  "name": "kubb-shared-output-repro",
  "version": "0.0.0",
  "private": true,
  "description": "Reproduction for kubb-labs/kubb#3660, testing output.shared from kubb-labs/kubb#4352",
  "type": "module",
  "scripts": {
    "generate": "kubb generate",
    "generate:without-shared": "NO_SHARED=1 kubb generate",
    "report": "node report.ts",
    "typecheck": "tsc --noEmit",
    "repro": "rm -rf gen && npm run generate && npm run report && npm run typecheck",
    "repro:diagnostics": "node repro-diagnostics.ts",
    "repro:broken": "WITH_BROKEN=1 node repro-diagnostics.ts",
    "repro:overlap": "rm -rf gen && SHARED_PATH=./gen kubb generate && ls gen",
    "repro:names": "node names.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@kubb/adapter-oas": "https://pkg.pr.new/kubb-labs/kubb/@kubb/adapter-oas@4a562fe",
    "@kubb/parser-ts": "https://pkg.pr.new/kubb-labs/kubb/@kubb/parser-ts@4a562fe",
    "@kubb/plugin-axios": "5.11.0",
    "@kubb/plugin-faker": "5.3.0",
    "@kubb/plugin-msw": "6.1.0",
    "@kubb/plugin-react-query": "5.8.0",
    "@kubb/plugin-ts": "5.4.0",
    "@kubb/plugin-zod": "5.8.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "^19.0.0",
    "axios": "^1.0.0",
    "kubb": "https://pkg.pr.new/kubb-labs/kubb/kubb@4a562fe",
    "msw": "^3.0.0",
    "react": "^19.0.0",
    "typescript": "^6.0.3",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@kubb/ast": "https://pkg.pr.new/kubb-labs/kubb/@kubb/ast@4a562fe",
    "@kubb/cli": "https://pkg.pr.new/kubb-labs/kubb/@kubb/cli@4a562fe",
    "@kubb/core": "https://pkg.pr.new/kubb-labs/kubb/@kubb/core@4a562fe",
    "@kubb/kit": "https://pkg.pr.new/kubb-labs/kubb/@kubb/kit@4a562fe",
    "@kubb/mcp": "https://pkg.pr.new/kubb-labs/kubb/@kubb/mcp@4a562fe",
    "@kubb/parser-md": "https://pkg.pr.new/kubb-labs/kubb/@kubb/parser-md@4a562fe",
    "@kubb/plugin-barrel": "https://pkg.pr.new/kubb-labs/kubb/@kubb/plugin-barrel@4a562fe",
    "@kubb/renderer-jsx": "https://pkg.pr.new/kubb-labs/kubb/@kubb/renderer-jsx@4a562fe",
    "@kubb/studio": "https://pkg.pr.new/kubb-labs/kubb/@kubb/studio@4a562fe",
    "unplugin-kubb": "https://pkg.pr.new/kubb-labs/kubb/unplugin-kubb@4a562fe",
    "@kubb/adapter-oas": "$@kubb/adapter-oas",
    "@kubb/parser-ts": "$@kubb/parser-ts",
    "kubb": "$kubb"
  },
  "engines": {
    "node": ">=22.18"
  }
}
